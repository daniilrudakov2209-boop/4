# and (И): Возвращает True, если оба выражения истинны.
result = (5 > 3) and (5 < 10)
result1 = (5 > 10) and (5 < 10)
print(result)
print(result1)

# or (ИЛИ): Возвращает True, если хотя бы одно из выражений истинно.
result3 = (5 > 3) or (5 < 10)
result2 = (5 > 10) or (5 < 10)
print(result3)
print(result2)

# not (НЕ): Инвертирует значение выражения.
result5 = not (5 < 2)
print(result5)

